<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--

  The lint gate: the Checkstyle rules that FAIL the build. The full,
  advisory configuration is checkstyle.xml. A rule graduates here once the
  tree is clean for it, or is grandfathered with entries in
  gate-suppressions.xml for the files that still violate it.

  Run with: ./gradlew lintGate (add the continue flag to see every module)
  CI: .github/workflows/groovy-lint-gate.yml

-->

<module name="Checker">
    <property name="localeCountry" value="en"/>
    <property name="localeLanguage" value="en"/>
    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file" value="${rootProject.projectDir}/config/checkstyle/gate-suppressions.xml"/>
    </module>

    <module name="TreeWalker">

        <module name="UnusedImports"/>

        <!--
          A package-qualified type name written in code where the simple name
          would do. Lines that are imports or package declarations, and any
          text after the first double quote on a line, are not considered, so
          class names inside string literals are left alone. Comments are
          skipped here and covered by the javadoc form below. When the simple
          name is taken by another import, suppress the file in
          gate-suppressions.xml with the reason.
        -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="FullyQualifiedName"/>
            <property name="format" value="^(?!\s*(?:import|package)\b)[^&quot;]*(?&lt;![\w.])(?:org|java|javax|jakarta|groovy)(?:\.[a-z][a-z0-9_]*)+\.[A-Z]\w*"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Import the type instead of writing its fully qualified name"/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="id" value="FullyQualifiedNameInJavadoc"/>
            <property name="format" value="\{@link(?:plain)?\s+(?:org|java|javax|jakarta|groovy)(?:\.[a-z][a-z0-9_]*)+\.[A-Z]"/>
            <property name="message" value="Import the type and link it by its simple name"/>
        </module>

    </module>
</module>
